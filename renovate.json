{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "7 days",
  "description": "Dependency updates wait 7 days after upstream release before a PR is raised; see docs/dependency-policy.md.",
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "minimumReleaseAge": "7 days",
      "groupName": "qualified updates"
    }
  ]
}
