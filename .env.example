# Omasnap runtime configuration (none of these are secrets).
# Copy to .env (gitignored) or export the variables you need; omasnap reads
# them from the environment, it never loads this file.

# Where saved screenshots are written (default: ~/Pictures/Screenshots).
#OMASNAP_SCREENSHOT_DIR="$HOME/Pictures/Captures"

# Tesseract OCR languages (Wayland), `+`-separated. Falls back to
# OMARCHY_OCR_LANGS, then eng.
#OMASNAP_OCR_LANGS="eng+deu"

# Runtime feature flags, comma-separated. Flags default to enabled; disable
# with name=0, !name, or name=false. Known flags: ocr_scan_sweep,
# desktop_notifications (see README).
#OMASNAP_FEATURE_FLAGS="ocr_scan_sweep=0"

# Trace id inherited by pins and hotkey-spawned captures so one capture
# session can be followed across processes. Set automatically; override only
# when correlating with an external launcher.
#OMASNAP_TRACE_ID=""

# Opt-in, strictly local usage events (JSON lines). Default: off.
#OMASNAP_ANALYTICS=1
#OMASNAP_ANALYTICS_FILE="/tmp/omasnap-analytics.jsonl"

# Writes collected performance metrics (capture_ms, quick_output_ms) as JSON
# when set to a writable path.
#OMASNAP_METRICS_FILE="/tmp/omasnap-metrics.json"

# Overrides the private working directory for snapshots, pins, and crash
# logs (default: $XDG_RUNTIME_DIR/omasnap). The smoke suite sets this per
# process to isolate parallel test runs.
#OMASNAP_RUNTIME_DIR="/tmp/omasnap-runtime"

# macOS global hotkeys for `omasnap --serve` (keys: a-z, 0-9, f1-f19, space,
# tab, return, esc, arrows).
#OMASNAP_HOTKEY_REGION="cmd+shift+r"
#OMASNAP_HOTKEY_WINDOW="cmd+shift+w"
#OMASNAP_HOTKEY_FULLSCREEN="cmd+shift+f"

# Install prefix override for ./install-omarchy.
#OMASNAP_PREFIX="$HOME/.local"
